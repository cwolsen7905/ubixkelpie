# uBixKelpie local env. # Copy to .env (composer create-project does this for you). Never commit .env.
#
# Secrets belong in uBixVault, not here. With VAULT_ADDR set, the framework
# resolves MYSQL_* credentials from Vault at startup and the MYSQL_* lines below
# can stay blank. See README "Secrets: use uBixVault".
VAULT_ADDR=''
VAULT_TOKEN=''
VAULT_K8S_ROLE=''
VAULT_DB_KV_PATH='app/db'
VAULT_TEST_DB_KV_PATH=''
VAULT_CACHE_TTL=''

IS_DEV='true'
IS_SANDBOX='false'
IS_STAGING='false'
LOGGER_PATH='log'
LOG_LEVEL='debug'
LATTE_CACHE_DIRECTORY='var/cache/latte/'
LATTE_TEMPLATES_DIRECTORY='templates/'
MEMCACHE_SERVERS=''
APP_URL='http://127.0.0.1:5173'
CORS_ALLOWED_ORIGINS='http://127.0.0.1:5173,http://localhost:5173'

# Databases - leave blank until you add a migration (bin/ubix migrate:*)
MYSQL_READ_HOST=''
MYSQL_READ_DATABASE=''
MYSQL_READ_USERNAME=''
MYSQL_READ_PASSWORD=''
MYSQL_READ_PORT=3306
MYSQL_WRITE_HOST=''
MYSQL_WRITE_DATABASE=''
MYSQL_WRITE_USERNAME=''
MYSQL_WRITE_PASSWORD=''
MYSQL_WRITE_PORT=3306
MYSQL_MIGRATION_USERNAME=''
MYSQL_MIGRATION_PASSWORD=''
TEST_MYSQL_WRITE_HOST='127.0.0.1'
TEST_MYSQL_WRITE_DATABASE=''
TEST_MYSQL_WRITE_USERNAME='root'
TEST_MYSQL_WRITE_PASSWORD=''
TEST_MYSQL_WRITE_PORT=3306
SLACK_API_ENDPOINT=''
# Deployed: from uBixVault kelpie/<env>/app (VAULT_APP_KV_PATH in app/KelpieApi/<env>-deploy.yaml).
GITLAB_WEBHOOK_SECRET=''
# Approval retry (docs/merge-signoff.md). Secrets: take them from uBixVault.
GITLAB_API_URL=''
GITLAB_PROJECT_TOKENS=''
GITLAB_API_TOKEN=''
APPROVAL_JOB_NAMES='require-approval,require-approval-mr'
# MR-thread triage (docs/design/mr-thread-autofix.md). Deployed: OPENROUTER_API_KEY comes from
# uBixVault kelpie/<env>/app like the secrets above (hydrated at startup via VAULT_APP_KV_PATH);
# never put a real key here.
OPENROUTER_API_KEY=''
OPENROUTER_API_URL=''
KELPIE_TRIAGE_MODEL='anthropic/claude-haiku-5.5'
